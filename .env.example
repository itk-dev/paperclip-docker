# Image tag: latest (stable), nightly, canary. Custom gateways (LiteLLM) need > v2026.1005.0 → nightly until next release
PAPERCLIP_IMAGE_TAG=nightly

COMPOSE_PROJECT_NAME=paperclip
COMPOSE_DOMAIN=paperclip.local.itkdev.dk
COMPOSE_SERVER_DOMAIN=paperclip.itkdev.dk

# echo $(htpasswd -nB paperclip) | sed -e s/\\$/\\$\\$/g
PAPERCLIP_BASIC_AUTH=

DB_PASSWORD=paperclip

# Host uid/gid owning ./data/paperclip (id -u / id -g)
USER_UID=1000
USER_GID=1000

# Change on server: openssl rand -hex 32
BETTER_AUTH_SECRET=paperclip-dev-secret
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=paperclip-dev-tool-action-signing-secret-change-me
